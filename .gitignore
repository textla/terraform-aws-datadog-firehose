*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log
*.tfplan

# Variable files (can contain secrets)
*.tfvars
*.tfvars.json

# Override files (local-only experimentation)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Environment
.env

# OS
.DS_Store

